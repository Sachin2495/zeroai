# MongoDB (Atlas SRV string recommended). Never commit the real value.
MONGODB_URI=mongodb://localhost:27017/agentic_interviewer
MONGODB_DB=agentic_interviewer

# LLM provider: groq (deployed) or ollama (local dev)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434

# Auth. JWT_SECRET signs invite + admin tokens: use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public URL of the frontend (used to build candidate invite links)
FRONTEND_URL=http://localhost:3000
INVITE_EXPIRY_HOURS=1

# Comma-separated allowed browser origins ("*" for any)
CORS_ORIGINS=*

PORT=8000
